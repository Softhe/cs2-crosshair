{
  "name": "delli-crosshair",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/pages-fallback.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "test:e2e": "playwright test"
  },
  "overrides": { "esbuild": "0.28.2" },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sharp": "0.35.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
