{
  "name": "cs2-crosshair",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-static-pages.mjs && pnpm verify:build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "import:preview-references": "node scripts/import-cs2-preview-references.mjs",
    "capture:preview": "node scripts/capture-preview-matrix.mjs",
    "analyze:preview": "node scripts/analyze-preview-calibration.mjs",
    "playtest:synthetic": "node scripts/run-synthetic-playtest.mjs",
    "report:preview": "node scripts/build-preview-calibration-report.mjs",
    "verify:release-readiness": "node scripts/verify-release-readiness.mjs",
    "test:watch": "vitest",
    "test:utils": "node scripts/verify-crosshair-utils.mjs",
    "verify:build": "node scripts/verify-build.mjs && node scripts/verify-performance-budget.mjs",
    "smoke:production": "node scripts/smoke-site.mjs https://delli.cc",
    "deps:check": "pnpm outdated",
    "check": "pnpm lint && pnpm typecheck && pnpm test:utils && pnpm test && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "lovable-tagger": "^1.3.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
