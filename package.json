{
  "name": "delli-crosshair",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/pages-fallback.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write server api",
    "format:check": "prettier --check server api",
    "test:e2e": "playwright test",
    "api": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "test:server": "tsx --test tests/server*.test.ts",
    "verify:library-fullstack": "tsx scripts/verify-library-fullstack.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-database.ts",
    "verify:neon": "node --env-file=.env.local --import tsx scripts/verify-neon.ts",
    "verify:vercel-preview": "node --env-file=.env.local --import tsx scripts/verify-vercel-preview.ts"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@neondatabase/serverless": "1.2.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": "24.x"
  }
}
